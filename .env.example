# Backend environment variables (Render)
# Copy this file to .env for local development and fill in real values.
# NEVER commit real values to Git.

# Tavily API key
TAVILY_API_KEY=

# Groq API key
GROQ_API_KEY=

# Mistral API key
MISTRAL_API_KEY=

# Google Sheets service-account credentials (full JSON content as a single-line string)
# Used by services/sheets_writer.py in production (Render).
# For local development, place credentials.json in the project root instead.
GOOGLE_CREDENTIALS_JSON=

# --- AI Agency / AI Engineer job research agent ---
# Spreadsheet that holds the AI_RECRUITMENT_AGENCIES + AI_ENGINEER_JOB_OPENINGS
# worksheets. The spreadsheet's existing worksheet is never touched.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=AI_RECRUITMENT_AGENCIES

# Optional PostgreSQL connection string (SQLAlchemy + psycopg2).
# Example: postgresql+psycopg2://user:password@host:5432/dbname
# When empty, the pipeline runs Sheets-first and skips database writes.
DATABASE_URL=

# Deployed Vercel frontend origin (CORS allowlist)
FRONTEND_URL=